MONGO_URI=mongodb://127.0.0.1:27017/forma_ai
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
# Optional OpenAI-compatible API endpoint
OPENAI_BASE_URL=
PORT=5000

# Optional LLM fallback providers: Claude, then local Ollama
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3

# JWT signing secret for RBAC — set a long random value in production
JWT_SECRET=change-me-to-a-long-random-string
